{
  "schema": "g5-fleet.server-routes/v1",
  "routes": [
    {
      "method": "GET",
      "path": "/healthz",
      "auth": "public",
      "site_context": false,
      "purpose": "process_liveness"
    },
    {
      "method": "GET",
      "path": "/readyz",
      "auth": "public",
      "site_context": false,
      "purpose": "database_and_web_asset_readiness"
    },
    {
      "method": "GET",
      "path": "/api/v1/meta",
      "auth": "public",
      "site_context": false,
      "purpose": "web_bootstrap_metadata"
    },
    {
      "method": "POST",
      "path": "/api/v1/bootstrap",
      "auth": "first_run_only",
      "site_context": false,
      "purpose": "initial_administrator"
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "auth": "public",
      "site_context": false,
      "purpose": "fleet_login"
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/logout",
      "auth": "session_csrf",
      "site_context": false,
      "purpose": "fleet_logout"
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/step-up",
      "auth": "session_csrf",
      "site_context": false,
      "purpose": "high_risk_reauthentication"
    },
    {
      "method": "GET",
      "path": "/api/v1/session",
      "auth": "session",
      "site_context": false,
      "purpose": "session_readback"
    },
    {
      "method": "GET",
      "path": "/api/v1/sites",
      "auth": "session",
      "site_context": false,
      "purpose": "owned_site_list"
    },
    {
      "method": "POST",
      "path": "/api/v1/sites",
      "auth": "session_csrf",
      "site_context": false,
      "purpose": "site_registration"
    },
    {
      "method": "GET",
      "path": "/api/v1/sites/{site_id}",
      "auth": "session",
      "site_context": true,
      "purpose": "owned_site_readback"
    },
    {
      "method": "PUT",
      "path": "/api/v1/sites/{site_id}/secrets",
      "auth": "session_csrf_step_up",
      "site_context": true,
      "purpose": "encrypted_site_secret"
    },
    {
      "method": "GET",
      "path": "/api/v1/sites/{site_id}/connector/health",
      "auth": "session",
      "site_context": true,
      "purpose": "connector_health"
    },
    {
      "method": "POST",
      "path": "/api/v1/sites/{site_id}/connector/login",
      "auth": "session_csrf_step_up",
      "site_context": true,
      "purpose": "connector_login_and_encrypted_token_store"
    },
    {
      "method": "GET",
      "path": "/api/v1/sites/{site_id}/overview",
      "auth": "session",
      "site_context": true,
      "purpose": "site_overview"
    },
    {
      "method": "GET",
      "path": "/api/v1/sites/{site_id}/config/basic",
      "auth": "session",
      "site_context": true,
      "purpose": "basic_config_readback"
    },
    {
      "method": "PUT",
      "path": "/api/v1/sites/{site_id}/config/basic",
      "auth": "session_csrf_step_up",
      "site_context": true,
      "purpose": "safe_cf_10_update"
    }
  ]
}
