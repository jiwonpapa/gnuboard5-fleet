# Gnuboard5 PHP REST API
# 환경변수 설정 파일 (이 파일을 .env로 복사 후 실제 값 입력)

# 앱 환경 (local | staging | production)
APP_ENV=local

# 런타임 모드 오버라이드 (비워두면 make 빌드 메타데이터 또는 APP_ENV/API_DEBUG를 사용)
APP_RUNTIME_MODE=

# 데이터베이스
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wolchuck
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
DB_TABLE_PREFIX=g5_

# 파일/스토리지 루트 (절대경로)
DATA_PATH=/home/neojins/public_html/data

# JWT 인증
# JWT_SECRET은 최소 32자 이상으로 설정
JWT_SECRET=
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=604800
JWT_LEEWAY_SECONDS=30
AUTH_AUTO_REHASH_ON_LOGIN=true

# Auth 토큰 만료/디버그 정책
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_EMAIL_VERIFY_TTL_SECONDS=86400
AUTH_EXPOSE_SENSITIVE_TOKENS=false
AUTH_MAIL_SEND_ENABLED=false
AUTH_MAIL_FROM=no-reply@example.com
AUTH_MAIL_SUBJECT_PREFIX=[G5 API]
AUTH_PASSWORD_RESET_URL=
AUTH_EMAIL_VERIFY_URL=

# 비밀번호 정책
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=true

# API
API_BASE_URL=https://localhost/api/v1
API_DEBUG=true
DEBUG_RESPONSE_INCLUDE_TRACE=true
DEBUG_TRACE_LIMIT=20
LOG_ERROR_PAYLOAD=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 프록시 신뢰 정책 (IP 스푸핑 방지)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=127.0.0.1,::1

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_WINDOW=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_STORAGE_PATH=

# 로깅 레벨 (debug | info | warning | error)
LOG_LEVEL=debug

# 패스워드 호환 모드 (원본 G5 config.php와 동일하게: create_hash | sql_password)
G5_ENCRYPT_FUNC=create_hash

# 설치 점검 엔드포인트 사용 여부 (true/false)
SETUP_ENABLED=false

# 관리자 SMS 도메인 노출 여부 (스테이징 기본 운영 정책에서 사용)
ADMIN_SMS_ENABLED=true

# local/staging 관리자 화면 감사 전용 bootstrap
ADMIN_SCHEMA_INSPECT_SECRET=
ADMIN_LEGACY_BOOTSTRAP_SECRET=
ADMIN_LEGACY_BOOTSTRAP_MEMBER_ID=neojins

# 완전 탈의존 모드 플래그
G5_INDEPENDENT=true

# 블랙박스 테스트(Schemathesis) 자동 인증/픽스처
SCHEMATHESIS_AUTO_AUTH=true
SCHEMATHESIS_AUTH_MB_ID=
SCHEMATHESIS_AUTH_MB_PASSWORD=
SCHEMATHESIS_AUTO_EXCLUDE_AUTH_REQUIRED_WHEN_NO_TOKEN=true
SCHEMATHESIS_AUTO_FIXTURES=true
SCHEMATHESIS_AUTO_EXCLUDE_MISSING_FIXTURES=true
SCHEMATHESIS_GENERATION_WITH_SECURITY_PARAMETERS=false
SCHEMATHESIS_GENERATION_ALLOW_X00=false
SCHEMATHESIS_FIXTURE_BO_TABLE=
SCHEMATHESIS_FIXTURE_WR_ID=
SCHEMATHESIS_FIXTURE_FILE_BO_TABLE=
SCHEMATHESIS_FIXTURE_FILE_WR_ID=
SCHEMATHESIS_FIXTURE_BF_NO=
SCHEMATHESIS_FIXTURE_LINK_BO_TABLE=
SCHEMATHESIS_FIXTURE_LINK_WR_ID=
SCHEMATHESIS_FIXTURE_LINK_NO=
SCHEMATHESIS_FIXTURE_MB_ID=
SCHEMATHESIS_FIXTURE_GR_ID=
SCHEMATHESIS_FIXTURE_MA_ID=
SCHEMATHESIS_FIXTURE_ME_ID=
SCHEMATHESIS_FIXTURE_PAGE_ID=
SCHEMATHESIS_FIXTURE_PO_ID=
SCHEMATHESIS_FIXTURE_QA_ID=
SCHEMATHESIS_FIXTURE_QA_FILE_ID=
SCHEMATHESIS_FIXTURE_QA_FILE_NO=
SCHEMATHESIS_FIXTURE_WIDGET_ID=
SCHEMATHESIS_FIXTURE_REPORT_ID=
