{
    "name": "premium-push",
    "vendor": "wolchuck",
    "version": "1.0.0",
    "description": "Premium push notification sample plugin with freemium routing",
    "require_api_version": ">=1.1.0",
    "license": {
        "type": "commercial",
        "check_url": "https://license.example.com/verify",
        "protected_paths": [
            "/send"
        ]
