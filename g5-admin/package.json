{
  "name": "g5-admin",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "overrides": {
    "dompurify": "3.4.12"
  },
  "scripts": {
    "ci:local": "bash ../scripts/run_local_ci.sh",
    "ci:release-local": "bash ../scripts/run_local_ci.sh --windows-target",
    "hooks:install": "bash ../scripts/install_local_hooks.sh",
    "audit:docs": "bash ../scripts/run_document_audit.sh",
    "audit:implementation": "bun run audit:standard",
    "audit:consumer": "bun run audit:contract",
    "audit:domain-consumer-parity": "python3 ../scripts/check_admin_domain_consumer_parity.py",
    "audit:domain-consumer-parity:all": "python3 ../scripts/run_all_admin_domain_consumer_parity.py",
    "audit:domain-consumer-render-parity": "python3 ../scripts/check_admin_domain_consumer_render_parity.py",
    "audit:domain-consumer-render-parity:all": "python3 ../scripts/run_all_admin_domain_consumer_render_parity.py",
    "audit:live-domain-registry": "python3 ../scripts/check_live_domain_certification_registry.py",
    "audit:live-domain-roundtrip": "cargo run --quiet -p g5-admin-api-client --example live_admin_domain_roundtrip --",
    "audit:structure": "bash ../scripts/run_structure_audit.sh",
    "audit:build-radius": "python3 ../scripts/check_build_radius_budgets.py",
    "audit:hotspots": "python3 ../scripts/run_hotspot_audit.py",
    "audit:standard": "bash ../scripts/run_standard_audit.sh",
    "audit:rust-workspace": "bash ../scripts/run_rust_workspace_audit.sh",
    "audit:contract": "bash ../scripts/run_contract_audit.sh",
    "audit:deep": "bash ../scripts/run_deep_audit.sh",
    "audit:integrated": "python3 ../scripts/run_integrated_audit.py --rust-root ..",
    "audit:integrated:php-rust": "bun run audit:integrated",
    "audit:api-pipeline": "python3 ../scripts/run_api_pipeline_audit.py",
    "audit:api-pipeline:static": "python3 ../scripts/run_api_pipeline_audit.py --static-only",
    "audit:harness:test": "python3 -m unittest discover -s ../scripts/tests -p 'test_*.py'",
    "audit:harness:quality": "bash ../scripts/run_harness_quality.sh",
    "audit:harness": "bun run audit:harness:test && bun run audit:harness:quality",
    "contract:sync": "bun ../scripts/sync_php_openapi_snapshot.mjs",
    "contract:generate": "bun ../scripts/check_openapi_contract.mjs --write",
    "contract:check": "bun ../scripts/check_openapi_contract.mjs --check",
    "dev": "vite",
    "build:web": "bun run contract:check && tsc && node ../scripts/run_vite_build_guard.mjs",
    "build:desktop": "bun run build:web && bash ../scripts/with_optional_sccache.sh bun run tauri build --bundles app",
    "build:web:fast": "tsc && node ../scripts/run_vite_build_guard.mjs",
    "build": "bun run build:web",
    "build:desktop:fast": "bun run build:web:fast && cargo build --manifest-path src-tauri/Cargo.toml --profile desktop-fast --features tauri/custom-protocol",
    "report:cargo-timings": "python3 ../scripts/report_cargo_timings.py",
    "check:windows-target": "bash ../scripts/run_windows_target_check.sh",
    "clean:rust-target": "bash ../scripts/with_optional_sccache.sh cargo clean --manifest-path src-tauri/Cargo.toml",
    "clean:desktop-fast-target": "bash ../scripts/with_optional_sccache.sh cargo clean --manifest-path src-tauri/Cargo.toml --profile desktop-fast",
    "clean:artifacts": "bash ../scripts/prune_build_artifacts.sh",
    "clean:artifacts:auto": "bash ../scripts/prune_build_artifacts.sh --auto",
    "clean:artifacts:full": "bash ../scripts/prune_build_artifacts.sh --full",
    "clean:artifacts:schedule": "bash ../scripts/install_build_prune_launchd.sh",
    "clean:web-cache": "rm -rf dist coverage coverage-critical ../.playwright-cli ../scripts/__pycache__ ../node_modules/.vite",
    "clean:cache": "bun run clean:rust-target && bun run clean:web-cache",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "smoke:bundle": "node ../scripts/run_dist_smoke_check.mjs",
    "deploy:desktop": "bun run build:desktop && bun ../scripts/deploy-rust-admin-desktop.mjs",
    "deploy:desktop:fast": "bun run build:desktop:fast && bun ../scripts/deploy-rust-admin-desktop.mjs --fast",
    "deploy:mac": "bun run deploy:desktop",
    "deploy:mac:fast": "bun run deploy:desktop:fast",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical.config.ts",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "monaco-editor": "^0.55.1",
    "prettier": "3.9.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-arborist": "^3.13.2",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xterm": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "openapi-zod-client": "^1.18.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
