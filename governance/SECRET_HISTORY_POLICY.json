{
  "$schema": "./schemas/secret-history-policy.schema.json",
  "schema_version": 1,
  "policy_id": "G5_FLEET_SECRET_HISTORY_V1",
  "forbidden_history_prefixes": [
    "output/",
    "connectors/gnuboard5-php/output/",
    "products/admin-desktop/output/"
  ],
  "allowlist": {
    "example_email_domains": [
      "example.com",
      "example.org",
      "example.net",
      "example.invalid",
      "test.invalid"
    ],
    "documentation_ip_networks": [
      "127.0.0.0/8",
      "192.0.2.0/24",
      "198.51.100.0/24",
      "203.0.113.0/24"
    ],
    "exact_match_hashes": [
      {
        "id": "fixture-top-secret",
        "sha256": "190aec7389a3b0b5b6c67ac2756cb7b7bc6e5d936ae83d34f55a150a67a13003",
        "pattern_ids": [
          "credential_assignment",
          "json_secret",
          "html_sensitive_input"
        ],
        "path_globs": [
          "tests/**",
          "**/tests/**",
          "examples/**",
          "**/examples/**"
        ],
        "reason": "Synthetic fixture value allowed only in test and example paths."
      },
      {
        "id": "desktop-example-master-password",
        "sha256": "38b593d2dde780b0ad5d3420d93dabb47b28c94471440d8d6e069a35ec5f8c2a",
        "pattern_ids": ["json_secret"],
        "path_globs": [
          "g5-admin/src-tauri/app-config.example.json",
          "products/admin-desktop/g5-admin/src-tauri/app-config.example.json"
        ],
        "reason": "Non-production change-me master password in the tracked desktop example config."
      },
      {
        "id": "desktop-example-site-password",
        "sha256": "e759df72c0314ac5ebd926a96fa5c750ecdb40ec5c9e10ca28c4e18f5ce091bf",
        "pattern_ids": ["json_secret"],
        "path_globs": [
          "g5-admin/src-tauri/app-config.example.json",
          "products/admin-desktop/g5-admin/src-tauri/app-config.example.json"
        ],
        "reason": "Non-production change-me site password in the tracked desktop example config."
      },
      {
        "id": "desktop-example-ssh-password",
        "sha256": "ced82494ea643c172e81f0f6c208aad3325470f64fbc7b34503a4a15f03da3bb",
        "pattern_ids": ["json_secret"],
        "path_globs": [
          "g5-admin/src-tauri/app-config.example.json",
          "products/admin-desktop/g5-admin/src-tauri/app-config.example.json"
        ],
        "reason": "Non-production change-me SSH password in the tracked desktop example config."
      }
    ]
  }
}
