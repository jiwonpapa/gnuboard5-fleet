{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiwonpapa/gnuboard5-fleet/governance/schemas/migration-batches.schema.json",
  "title": "G5 Fleet Domain Migration Batches",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy",
    "batches"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "g5-fleet.migration-batches/v1"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_batch"
      ],
      "properties": {
        "final_batch": {
          "type": "string",
          "pattern": "^R[0-9]{2}$"
        }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/batch"
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "expected_count"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              ".*",
              ".+",
              "^.*$",
              "^.+$"
            ]
          }
        },
        "expected_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ruleList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tauri_commands": {
          "$ref": "#/$defs/ruleList"
        },
        "react_pages": {
          "$ref": "#/$defs/ruleList"
        },
        "rust_workspace_members": {
          "$ref": "#/$defs/ruleList"
        },
        "frontend_tests": {
          "$ref": "#/$defs/ruleList"
        },
        "rust_tests": {
          "$ref": "#/$defs/ruleList"
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "operation_ids",
        "expected_count"
      ],
      "properties": {
        "domains": {
          "$ref": "#/$defs/stringList"
        },
        "operation_ids": {
          "$ref": "#/$defs/stringList"
        },
        "expected_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "batch_pass"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "completion"
            ]
          },
          "else": {
            "not": {
              "required": [
                "completion"
              ]
            }
          }
        }
      ],
      "required": [
        "id",
        "sequence",
        "title",
        "state",
        "depends_on",
        "core",
        "legacy",
        "capability_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]{2}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "planned",
            "active",
            "batch_pass"
          ]
        },
        "depends_on": {
          "$ref": "#/$defs/stringList"
        },
        "control_only": {
          "type": "boolean"
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation_commit",
            "evidence_path",
            "closed_at"
          ],
          "properties": {
            "implementation_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "evidence_path": {
              "type": "string",
              "minLength": 1
            },
            "closed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "core": {
          "$ref": "#/$defs/core"
        },
        "legacy": {
          "$ref": "#/$defs/legacy"
        },
        "capability_ids": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
