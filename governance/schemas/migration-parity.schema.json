{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jiwonpapa/gnuboard5-fleet/governance/schemas/migration-parity.schema.json",
  "title": "G5 Fleet Migration Parity Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy",
    "legacy_baseline",
    "active_expectations",
    "mappings",
    "required_capabilities",
    "evidence_registry",
    "profile_evidence",
    "staging"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "g5-fleet.migration-parity/v1"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_target_roots",
        "runtime_evidence_max_age_hours"
      ],
      "properties": {
        "allowed_target_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_evidence_max_age_hours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "legacy_baseline": {
      "$ref": "#/$defs/legacyCategories"
    },
    "active_expectations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "exact": {
            "type": "integer",
            "minimum": 0
          },
          "minimum": {
            "type": "integer",
            "minimum": 0
          }
        },
        "anyOf": [
          {
            "required": [
              "exact"
            ]
          },
          {
            "required": [
              "minimum"
            ]
          }
        ]
      }
    },
    "mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tauri_commands",
        "react_pages",
        "rust_workspace_members",
        "frontend_tests",
        "rust_tests"
      ],
      "properties": {
        "tauri_commands": {
          "$ref": "#/$defs/mappingList"
        },
        "react_pages": {
          "$ref": "#/$defs/mappingList"
        },
        "rust_workspace_members": {
          "$ref": "#/$defs/mappingList"
        },
        "frontend_tests": {
          "$ref": "#/$defs/mappingList"
        },
        "rust_tests": {
          "$ref": "#/$defs/mappingList"
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "evidence_registry": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evidence"
      }
    },
    "profile_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static",
        "runtime",
        "staging"
      ],
      "properties": {
        "static": {
          "$ref": "#/$defs/stringList"
        },
        "runtime": {
          "$ref": "#/$defs/stringList"
        },
        "staging": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url_env",
        "timeout_seconds",
        "probes"
      ],
      "properties": {
        "base_url_env": {
          "type": "string",
          "minLength": 1
        },
        "ca_file_env": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "method",
              "status",
              "json"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "method": {
                "enum": [
                  "GET",
                  "POST"
                ]
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "json": {
                "type": "boolean"
              },
              "expect": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "fingerprint"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "legacyCategories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tauri_commands",
        "react_pages",
        "rust_workspace_members",
        "frontend_tests",
        "rust_tests"
      ],
      "properties": {
        "tauri_commands": {
          "$ref": "#/$defs/baseline"
        },
        "react_pages": {
          "$ref": "#/$defs/baseline"
        },
        "rust_workspace_members": {
          "$ref": "#/$defs/baseline"
        },
        "frontend_tests": {
          "$ref": "#/$defs/baseline"
        },
        "rust_tests": {
          "$ref": "#/$defs/baseline"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contains": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "contains"
          ]
        },
        {
          "required": [
            "regex"
          ]
        }
      ]
    },
    "implementation": {
      "type": "object",
      "properties": {
        "target_paths": {
          "$ref": "#/$defs/stringList"
        },
        "test_paths": {
          "$ref": "#/$defs/stringList"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "evidence_ids": {
          "$ref": "#/$defs/stringList"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mappingList": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/implementation"
          },
          {
            "type": "object",
            "required": [
              "legacy_id",
              "disposition"
            ],
            "properties": {
              "legacy_id": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "reused",
                  "adapted",
                  "redesigned",
                  "deferred"
                ]
              },
              "tracking": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "issue",
                  "review_after"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "issue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "review_after": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "capability": {
      "allOf": [
        {
          "$ref": "#/$defs/implementation"
        },
        {
          "type": "object",
          "required": [
            "id",
            "state",
            "description"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "implemented",
                "pending"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "profiles": {
              "type": "array",
              "items": {
                "enum": [
                  "static",
                  "runtime",
                  "staging"
                ]
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "revision_field": {
          "type": "string"
        },
        "timestamp_field": {
          "type": "string"
        }
      }
    }
  }
}
