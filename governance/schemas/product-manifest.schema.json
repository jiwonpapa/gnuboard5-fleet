{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g5-fleet.local/schemas/product-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "product_id", "product_name", "deployment_model", "editions", "provider_scope", "contract_baseline", "notification_baseline", "tablet_strategy"],
  "properties": {
    "$schema": {"const": "./governance/schemas/product-manifest.schema.json"},
    "schema_version": {"const": 1},
    "product_id": {"const": "g5-fleet"},
    "product_name": {"type": "string", "minLength": 1},
    "deployment_model": {"const": "self_hosted_server"},
    "editions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fleet_core", "commerce"],
      "properties": {
        "fleet_core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pricing", "source_license", "required", "capabilities"],
          "properties": {
            "pricing": {"const": "free"},
            "source_license": {"type": "string", "minLength": 1},
            "required": {"const": true},
            "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "commerce": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pricing", "delivery", "source_license", "required", "implementation_location", "contract_location"],
          "properties": {
            "pricing": {"const": "paid"},
            "delivery": {"const": "optional_plugin"},
            "source_license": {"const": "commercial"},
            "required": {"const": false},
            "implementation_location": {"const": "separate_private_repository"},
            "contract_location": {"const": "plugins/commerce-sdk"}
          }
        }
      }
    },
    "provider_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admin_non_shop", "board", "shop"],
      "properties": {
        "admin_non_shop": {"const": "active"},
        "board": {"const": "provider_retained_consumer_deferred"},
        "shop": {"const": "provider_retained_commerce_consumer"}
      }
    },
    "contract_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi_operations", "openapi_operation_keys_sha256", "active_operations", "admin_non_shop_operations", "bootstrap_operations", "protected_board_operations", "shop_provider_operations"],
      "properties": {
        "openapi_operations": {"const": 312},
        "openapi_operation_keys_sha256": {"const": "ff22a5d1649c9bf81317726f9561b7e1886ebda11b99833628eb9676989f8c62"},
        "active_operations": {"const": 189},
        "admin_non_shop_operations": {"const": 184},
        "bootstrap_operations": {"const": 5},
        "protected_board_operations": {"const": 26},
        "shop_provider_operations": {"const": 26}
      }
    },
    "notification_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "enabled_by_default", "external_delivery_in_routine_tests"],
      "properties": {
        "channels": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["telegram", "web_push"]}},
        "enabled_by_default": {"const": false},
        "external_delivery_in_routine_tests": {"const": false}
      }
    },
    "tablet_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_delivery", "optional_native_wrapper"],
      "properties": {
        "initial_delivery": {"const": "responsive_pwa"},
        "optional_native_wrapper": {"const": "tauri_mobile"}
      }
    }
  }
}
