{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g5-fleet.local/schemas/product-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "product_id", "product_name", "deployment_model", "editions", "provider_scope", "contract_baseline", "notification_baseline", "server_storage", "web_delivery"],
  "properties": {
    "$schema": {"const": "./governance/schemas/product-manifest.schema.json"},
    "schema_version": {"const": 2},
    "product_id": {"const": "g5-fleet"},
    "product_name": {"type": "string", "minLength": 1},
    "deployment_model": {"const": "self_hosted_server"},
    "editions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fleet_core", "commerce"],
      "properties": {
        "fleet_core": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pricing", "source_license", "required", "capabilities"],
          "properties": {
            "pricing": {"const": "free"},
            "source_license": {"const": "Apache-2.0"},
            "required": {"const": true},
            "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "commerce": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pricing", "delivery", "source_license", "sdk_license", "third_party_license_policy", "required", "implementation_location", "contract_location"],
          "properties": {
            "pricing": {"const": "paid"},
            "delivery": {"const": "optional_plugin"},
            "source_license": {"const": "commercial"},
            "sdk_license": {"const": "Apache-2.0"},
            "third_party_license_policy": {"const": "independent_per_plugin"},
            "required": {"const": false},
            "implementation_location": {"const": "separate_private_repository"},
            "contract_location": {"const": "plugins/commerce-sdk"}
          }
        }
      }
    },
    "provider_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admin_non_shop", "board", "shop"],
      "properties": {
        "admin_non_shop": {"const": "active"},
        "board": {"const": "provider_retained_consumer_deferred"},
        "shop": {"const": "provider_retained_commerce_consumer"}
      }
    },
    "contract_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi_operations", "openapi_operation_keys_sha256", "active_operations", "admin_non_shop_operations", "bootstrap_operations", "protected_board_operations", "shop_provider_operations"],
      "properties": {
        "openapi_operations": {"const": 312},
        "openapi_operation_keys_sha256": {"const": "ff22a5d1649c9bf81317726f9561b7e1886ebda11b99833628eb9676989f8c62"},
        "active_operations": {"const": 189},
        "admin_non_shop_operations": {"const": 184},
        "bootstrap_operations": {"const": 5},
        "protected_board_operations": {"const": 26},
        "shop_provider_operations": {"const": 26}
      }
    },
    "notification_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "enabled_by_default", "external_delivery_in_routine_tests"],
      "properties": {
        "channels": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["telegram", "web_push"]}},
        "enabled_by_default": {"const": false},
        "external_delivery_in_routine_tests": {"const": false}
      }
    },
    "server_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "journal_mode", "synchronous", "external_database_required", "secret_encryption", "corruption_policy", "consistent_backup_required", "restore_readback_required"],
      "properties": {
        "engine": {"const": "sqlite"},
        "journal_mode": {"const": "wal"},
        "synchronous": {"const": "full"},
        "external_database_required": {"const": false},
        "secret_encryption": {"const": "application_level"},
        "corruption_policy": {"const": "fail_closed_no_auto_recreate"},
        "consistent_backup_required": {"const": true},
        "restore_readback_required": {"const": true}
      }
    },
    "web_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_type", "runtime", "served_by", "desktop_binary", "native_wrapper"],
      "properties": {
        "application_type": {"const": "responsive_spa_pwa"},
        "runtime": {"const": "browser"},
        "served_by": {"const": "admin_server"},
        "desktop_binary": {"const": false},
        "native_wrapper": {"const": false}
      }
    }
  }
}
