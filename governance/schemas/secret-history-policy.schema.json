{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g5-fleet.local/schemas/secret-history-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "policy_id", "forbidden_history_prefixes", "allowlist"],
  "properties": {
    "$schema": {"const": "./schemas/secret-history-policy.schema.json"},
    "schema_version": {"const": 1},
    "policy_id": {"const": "G5_FLEET_SECRET_HISTORY_V1"},
    "forbidden_history_prefixes": {
      "const": [
        "output/",
        "connectors/gnuboard5-php/output/",
        "products/admin-desktop/output/"
      ]
    },
    "allowlist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_email_domains", "documentation_ip_networks", "exact_match_hashes"],
      "properties": {
        "example_email_domains": {
          "const": [
            "example.com",
            "example.org",
            "example.net",
            "example.invalid",
            "test.invalid"
          ]
        },
        "documentation_ip_networks": {
          "const": [
            "127.0.0.0/8",
            "192.0.2.0/24",
            "198.51.100.0/24",
            "203.0.113.0/24"
          ]
        },
        "exact_match_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256", "pattern_ids", "path_globs", "reason"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "pattern_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,63}$"
                }
              },
              "path_globs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\r\\n]+$"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 12,
                "maxLength": 240,
                "pattern": "^[^\\r\\n]+$"
              }
            }
          }
        }
      }
    }
  }
}
