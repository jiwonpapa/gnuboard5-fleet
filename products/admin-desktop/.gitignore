# ========================================
# G5 Admin Tauri + Rust Workspace
# ========================================

# --- Rust / Cargo ---
/target/
**/target/
**/*.rs.bk
*.pdb
# 이 workspace는 Tauri 바이너리를 배포하므로 루트 Cargo.lock을 추적한다.

# --- Tauri ---
g5-admin/src-tauri/target/
g5-admin/src-tauri/gen/
g5-admin/src-tauri/WixTools/
# Tauri bundle icons are required source assets and must stay tracked.
g5-admin/src-tauri/src/types/

# --- Node.js / pnpm (React 프론트엔드) ---
node_modules/
**/node_modules/
.pnpm-store/
.pnpm-debug.log

# --- Vite ---
g5-admin/dist/
g5-admin/dist-ssr/
g5-admin/logs/

# --- Monaco editor generated bundle assets ---
# node_modules / dist 전체가 이미 무시되지만, 편집기 worker/font chunk는 의도를 명시해 둔다.
g5-admin/dist/assets/vendor-editor*
g5-admin/dist/assets/editor.worker-*
g5-admin/dist/assets/json.worker-*
g5-admin/dist/assets/codicon-*

# --- TypeScript ---
*.tsbuildinfo

# --- ts-rs 자동 생성 (재생성 가능) ---
# g5-admin/src/types/generated/

